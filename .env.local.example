# --- PG360 environment ---
# Copy to .env.local and fill in. The app runs in DEMO mode (seeded in-memory data)
# until real Supabase keys are present, then it switches to the live backend.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used for admin-side user creation.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (image uploads — payment screenshots, KYC docs). Secret is server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
